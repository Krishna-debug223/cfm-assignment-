    "def validate_portfolio(portfolio_final, eligible, budget, label=\"\"):\n",
    "    portfolio_final = portfolio_final.copy()\n",
    "   \n",
    "    print(\"TASK 3 - VALIDATION CHECKS\" + (f\" ({label})\" if label else \"\"))\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "    # 1. every ticker in the final portfolio is eligible and unique\n",
    "    all_valid = True\n",
    "    for ticker in portfolio_final['Ticker']:\n",
    "        if ticker not in eligible.index:\n",
    "            all_valid = False\n",
    "        else:\n",
    "            row = eligible.loc[ticker]\n",
    "            if (row['Type'] != 'EQUITY'\n",
    "                or row['Currency'] not in ['USD', 'CAD']\n",
    "                or row['Market'] not in ['us_market', 'ca_market']\n",
    "                or pd.isna(row['Avg_Volume']) or row['Avg_Volume'] < 5000):\n",
    "                all_valid = False\n",
    "    if not portfolio_final['Ticker'].is_unique:\n",
    "        all_valid = False\n",
    "    print(\"All tickers eligible & unique:\", all_valid)\n",
    "\n",
    "    # 2. stock count between 10 and 20\n",
    "    n_stocks = len(portfolio_final)\n",
    "    count_ok = 10 <= n_stocks <= 20\n",
    "    print(\"Stock count (10-20):\", count_ok, \"-\", n_stocks, \"stocks\")\n",
    "\n",
    "    # 3. no stock over 15%\n",
    "    max_weight = portfolio_final['Weight'].max()\n",
    "    max_weight_ok = max_weight <= 0.15 + tolerance\n",
    "    print(\"Max individual weight <= 15%:\", max_weight_ok, \"-\", round(max_weight * 100, 2), \"%\")\n",
    "\n",
    "    # 4. no sector over 40%\n",
    "    portfolio_final['Sector'] = portfolio_final['Ticker'].map(eligible['Sector'])\n",
    "    sector_weights = portfolio_final.groupby('Sector')['Weight'].sum()\n",
    "    max_sector_weight = sector_weights.max()\n",
    "    max_sector_ok = max_sector_weight <= 0.40 + tolerance\n",
    "    print(\"Max sector weight <= 40%:\", max_sector_ok, \"-\", round(max_sector_weight * 100, 2), \"% (\" + sector_weights.idxmax() + \")\")\n",
    "\n",
    "    # 5. weights sum to 100%\n",
    "    weight_sum = portfolio_final['Weight'].sum()\n",
    "    weight_sum_ok = abs(weight_sum - 1) < tolerance\n",
    "    print(\"Weights sum to 100%:\", weight_sum_ok, \"-\", round(weight_sum * 100, 2), \"%\")\n",
    "\n",
    "    # 6. total spent + fees within budget\n",
    "    total_value = portfolio_final['Value'].sum()\n",
    "    total_fees = 0\n",
    "    for shares in portfolio_final['Shares']:\n",
    "        total_fees = total_fees + calc_fee_cad(shares)\n",
    "    total_spent = total_value + total_fees\n",
    "    budget_ok = total_spent <= budget + tolerance\n",
    "    print(\"Spend + fees within budget:\", budget_ok, \"-\", \"$\" + str(round(total_spent, 2)), \"of\", \"$\" + str(budget))\n",
    "\n",
    "    print(\"-\" * 40)\n",
    "    all_passed = all_valid and count_ok and max_weight_ok and max_sector_ok and weight_sum_ok and budget_ok\n",
    "    print(\"ALL CHECKS PASSED:\", all_passed)\n",
    "    print()\n",
    "\n",
    "    return all_passed\n",
    "\n",
    "passed_A = validate_portfolio(Portfolio_Final_A, eligible_stocks, budget_A, \"Client A\")\n",
    "passed_B = validate_portfolio(Portfolio_Final_B, eligible_stocks, budget_B, \"Client B\")\n",
