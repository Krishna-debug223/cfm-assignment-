    "mask = all_stocks['Type'] == 'EQUITY'\n",
    "mask1 = all_stocks['Currency'].isin(['USD', 'CAD'])\n",
    "mask2 = all_stocks['Market'].isin(['us_market', 'ca_market'])\n",
    "mask3 = all_stocks['Sector'].notna() & (all_stocks['Sector'] != '')\n",
    "\n",
    "eligible_stocks = all_stocks[mask & mask1 & mask2 & mask3].copy()\n",
    "eligible_stocks"
   ]
