    "# If a bucket has too few names or too little sector capacity, fill by score.\n",
    "# A stock adds room until its sector reaches the 40% limit.\n",
    "def basket_capacity(tickers_A):\n",
    "    counts = eligible_A.loc[tickers_A, \"Sector\"].value_counts()\n",
    "    return (counts * 0.15).clip(upper=0.40).sum()\n",
    "\n",
