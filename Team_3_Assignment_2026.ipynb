   "source": [
    "one_year_ago = (pd.Timestamp(buy_date) - pd.DateOffset(years=1)).strftime('%Y-%m-%d')\n",
    "\n",
    "for ticker in eligible_A.index.tolist():\n",
    "    history = hist_data[ticker]\n",
    "    old_price = history['Close'].dropna().asof(pd.Timestamp(one_year_ago))\n",
    "    new_price = eligible_A.loc[ticker, 'Close']\n",
    "\n",
    "    if pd.notna(old_price) and old_price > 0 and pd.notna(new_price):\n",
    "        eligible_A.loc[ticker, 'Return %'] = (new_price - old_price) / old_price * 100\n",
    "    else:\n",
    "        eligible_A.loc[ticker, 'Return %'] = None\n",
    "\n",
    "# Drop any stock we couldn't compute a 1-year return for \n",
    "eligible_A = eligible_A.dropna(subset=['Return %']).copy()\n",
    "eligible_A"
   ]
  },
