    "def capped_weights(scores, caps, total):\n",
    "    caps = np.array(caps)\n",
    "    result = np.zeros(len(scores))\n",
    "    free = caps > 0\n",
    "    remaining = total\n",
    "    while free.any() and remaining > 1e-12:\n",
    "        # Only update positions that are still open.\n",
    "        proposal = result.copy()\n",
    "        proposal[free] = scores[free] / scores[free].sum() * remaining\n",
    "        over = free & (proposal > caps)\n",
    "        if not over.any():\n",
    "            return proposal\n",
    "        # Fix the positions above their caps before the next round.\n",
    "        result[over] = caps[over]\n",
    "        free[over] = False\n",
    "        remaining = total - result.sum()\n",
    "    return result"
   ]
