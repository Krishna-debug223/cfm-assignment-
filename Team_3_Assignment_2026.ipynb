   "source": [
    "type_s= []\n",
    "currency = []\n",
    "market = []\n",
    "sector = []\n",
    "\n",
    "for ticker in tickers: \n",
    "    try: \n",
    "        tick = raw_info.get(ticker)\n",
    "        type_s.append(tick.get('quoteType'))\n",
    "        currency.append(tick.get('currency'))\n",
    "        market.append(tick.get('market'))\n",
    "        sector.append(tick.get('sector'))\n",
    "    except:\n",
    "        type_s.append(None)\n",
    "        currency.append(None)\n",
    "        market.append(None)\n",
    "        sector.append(None)\n",
    "\n",
    "info = {\n",
    "    'Type' : type_s,\n",
    "    'Currency' : currency,\n",
    "    'Market' : market,\n",
    "    'Sector' : sector\n",
    "}\n",
    "\n",
    "all_stocks = pd.DataFrame(info, index=tickers)\n",
    "all_stocks.index.name = 'Ticker'\n",
    "all_stocks"
   ]
  },
