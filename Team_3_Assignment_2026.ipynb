    "# Build CAD daily price history over the eligibility window (start to end) using shared hist_data and fx_rate_daily\n",
    "close_window_B = {}\n",
    "for ticker in eligible_stocks.index:\n",
    "    close_window_B[ticker] = to_naive_dates(hist_data[ticker]['Close'].loc[start:end])\n",
    "\n",
    "close_df_B = pd.DataFrame(close_window_B).sort_index()\n",
    "fx_window_B = fx_rate_daily.reindex(close_df_B.index).ffill().bfill()\n",
    "\n",
    "cad_prices_B = {}\n",
    "for ticker in eligible_stocks.index:\n",
    "    s_prices = close_df_B[ticker]\n",
    "    if eligible_stocks.at[ticker, \"Currency\"] == \"USD\":\n",
    "        s_prices = s_prices.ffill() * fx_window_B\n",
    "    cad_prices_B[ticker] = s_prices\n",
    "\n",
    "# Fixed shares, price returns only. Carry the last close across market holidays.\n",
    "# Score every candidate on the same dates, starting after all have prices.\n",
    "stock_days_B = close_df_B[eligible_stocks.index].notna().any(axis=1)\n",
    "prices_cad_B = pd.DataFrame(cad_prices_B)[eligible_stocks.index].loc[stock_days_B].ffill().dropna()\n",
    "daily_returns_B = prices_cad_B.pct_change().dropna()\n",
    "vol_B = daily_returns_B.std()\n",
    "usable_B = vol_B[(vol_B > 0) & np.isfinite(vol_B)].index\n",
    "prices_cad_B = prices_cad_B[usable_B]\n",
    "daily_returns_B = daily_returns_B[usable_B]\n",
    "vol_B = vol_B[usable_B]\n",
    "if len(usable_B) < 10 or len(daily_returns_B) < 2:\n",
    "    raise ValueError(\"Too few usable stocks or common return dates. Inspect the Yahoo data.\")\n",
    "print(\"Usable stocks for Client B:\", len(usable_B), \"| Common daily returns:\", len(daily_returns_B))"
