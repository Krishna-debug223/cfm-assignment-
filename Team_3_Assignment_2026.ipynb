   "source": [
    "usdcad = yf.Ticker('USDCAD=X').history(start=buy_date, end=end_date)\n",
    "rate = float(usdcad['Close'].dropna().iloc[-1])\n",
    "\n",
    "for ticker in eligible_stocks.index.tolist():\n",
    "    price = eligible_stocks.loc[ticker, 'Close']\n",
    "    if eligible_stocks.loc[ticker, 'Currency'] == 'USD':\n",
    "        eligible_stocks.loc[ticker, 'Close_CAD'] = price * rate\n",
    "    else :\n",
    "        eligible_stocks.loc[ticker, 'Close_CAD'] = price\n",
    "\n",
    "# Daily USD/CAD rate over the whole window (used by Client A comparison and Client B)\n",
    "fx_hist = yf.Ticker('USDCAD=X').history(start=global_start, end=end_date)\n",
    "fx_rate_daily = fx_hist['Close']\n",
    "\n",
    "#to fix the timezone issues\n",
    "def to_naive_dates(series):\n",
    "    series = series.copy()\n",
    "    series.index = pd.to_datetime(series.index.date)\n",
    "    return series\n",
    "\n",
    "fx_rate_daily = to_naive_dates(fx_rate_daily)\n",
    "\n",
    "fee_rate = 0.001\n",
    "def calc_fee_cad(shares_num):\n",
    "    return min(shares_num * fee_rate, 2.15) * rate\n",
    "\n",
    "eligible_stocks"
   ]
  },
