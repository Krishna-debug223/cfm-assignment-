   "source": [
    "beta_norm = (eligible_A['Beta'] - eligible_A['Beta'].min()) / (eligible_A['Beta'].max() - eligible_A['Beta'].min())\n",
    "return_norm = (eligible_A['Return %'] - eligible_A['Return %'].min()) / (eligible_A['Return %'].max() - eligible_A['Return %'].min())\n",
    "\n",
    "eligible_A['Score'] = (beta_norm + return_norm) / 2\n",
    "eligible_A.sort_values('Score', ascending=False)"
   ]
