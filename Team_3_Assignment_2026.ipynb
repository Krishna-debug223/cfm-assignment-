    "def compare_portfolios(portfolio, eligible):\n",
    "    # build CAD daily prices and daily returns for the stocks in this portfolio\n",
    "    returns_data = {}\n",
    "    fx_slice = fx_rate_daily.loc[one_year_ago:buy_date]\n",
    "    for ticker in portfolio.index.tolist():\n",
    "        prices = hist_data[ticker]['Close'].loc[one_year_ago:buy_date]\n",
    "        prices = to_naive_dates(prices)\n",
    "\n",
    "        if eligible.loc[ticker, 'Currency'] == 'USD':\n",
    "            prices_cad = prices * fx_slice\n",
    "        else:\n",
    "            prices_cad = prices\n",
    "\n",
    "        returns_data[ticker] = prices_cad.ffill().pct_change(fill_method=None)\n",
    "\n",
    "    returns_df = pd.DataFrame(returns_data).dropna()\n",
    "\n",
    "    strategy_returns = pd.Series(0, index=returns_df.index)\n",
    "    for ticker in portfolio.index.tolist():\n",
    "        strategy_returns = strategy_returns + returns_df[ticker] * portfolio.loc[ticker, 'Weight']\n",
    "\n",
    "    # equal-weighted daily return: same stocks, weight = 1/n for every one\n",
    "    equal_weight = 1 / len(portfolio)\n",
    "    equal_returns = pd.Series(0, index=returns_df.index)\n",
    "    for ticker in portfolio.index.tolist():\n",
    "        equal_returns = equal_returns + returns_df[ticker] * equal_weight\n",
    "\n",
    "    trading_days = 252\n",
    "    comparison = pd.DataFrame({\n",
    "        'Avg Daily Return %': [strategy_returns.mean() * 100, equal_returns.mean() * 100],\n",
    "        'Daily Volatility %': [strategy_returns.std() * 100, equal_returns.std() * 100],\n",
    "        'Annualized Return %': [strategy_returns.mean() * trading_days * 100, equal_returns.mean() * trading_days * 100],\n",
    "        'Annualized Volatility %': [strategy_returns.std() * (trading_days ** 0.5) * 100, equal_returns.std() * (trading_days ** 0.5) * 100]\n",
    "    }, index=['Portfolio A - Strategy Weights', 'Portfolio A - Equal Weights'])\n",
    "\n",
    "    return comparison\n",
    "\n",
    "print(\"Client A comparison window:\", one_year_ago, \"to\", buy_date)\n",
    "comparison_A = compare_portfolios(portfolio_A, eligible_A)\n",
    "display(comparison_A)"
   ]
