    "# Score Client A on a separate table so its filters do not change Client B.\n",
    "eligible_A = eligible_stocks.copy()\n",
    "fx_daily = close[fx_symbol].ffill()\n",
    "market_close_cad = close[benchmark] * fx_daily\n",
    "eligible_A[\"Return %\"] = np.nan\n",
    "for ticker in eligible_A.index:\n",
    "    quoted = close[ticker].dropna()\n",
    "    stock_close = quoted.loc[one_year_ago:price_date]\n",
    "    if eligible_A.at[ticker, \"Currency\"] == \"USD\":\n",
    "        stock_close = stock_close * fx_daily.reindex(stock_close.index)\n",
    "\n",
    "    # Estimate beta over the trailing year in CAD for both stock and benchmark.\n",
    "    both = pd.concat([stock_close.rename(\"stock\"), market_close_cad.rename(\"market\")],\n",
    "                     axis=1).loc[one_year_ago:price_date].dropna()\n",
    "    both_returns = both.pct_change().dropna()\n",
    "    market_variance = both_returns[\"market\"].var()\n",
    "    if len(both_returns) > 1 and market_variance > 0:\n",
    "        beta = both_returns[\"stock\"].cov(both_returns[\"market\"]) / market_variance\n",
    "    else:\n",
    "        beta = eligible_A.at[ticker, \"Yahoo_Beta\"]\n",
    "        if pd.isna(beta):\n",
    "            beta = 1.0\n",
    "    eligible_A.at[ticker, \"Beta\"] = beta\n",
    "\n",
    "    # Price momentum uses the stock's quoted currency, as in the growth strategy.\n",
    "    old_price = quoted.asof(one_year_ago)\n",
    "    if pd.notna(old_price) and old_price > 0:\n",
    "        eligible_A.loc[ticker, \"Return %\"] = (quoted.loc[price_date] / old_price - 1) * 100\n",
    "\n",
    "eligible_A = eligible_A.dropna(subset=[\"Beta\", \"Return %\"]).copy()\n",
    "if len(eligible_A) < 10:\n",
    "    raise ValueError(\"Client A needs at least ten eligible stocks with a one-year return.\")\n",
    "\n",
    "def scaled_score(series):\n",
    "    spread = series.max() - series.min()\n",
    "    if spread == 0:\n",
    "        return pd.Series(0.5, index=series.index)\n",
    "    return (series - series.min()) / spread\n",
    "\n",
    "eligible_A[\"Score\"] = (scaled_score(eligible_A[\"Beta\"]) + scaled_score(eligible_A[\"Return %\"])) / 2"
