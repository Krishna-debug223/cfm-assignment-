   "source": [
    "eligible_A = eligible_stocks.copy()\n",
    "\n",
    "market_hist = yf.download('^GSPC', start=global_start, end=global_end)\n",
    "market_close = market_hist['Close']['^GSPC']\n",
    "\n",
    "for ticker in eligible_A.index.tolist():\n",
    "    both = pd.DataFrame({'stock': hist_data[ticker]['Close'], 'market': market_close}).dropna()\n",
    "    both_returns = both.pct_change().dropna()\n",
    "\n",
    "    manual_beta = both_returns['stock'].cov(both_returns['market']) / both_returns['market'].var()\n",
    "    eligible_A.loc[ticker, 'Beta'] = manual_beta\n",
    "\n",
    "eligible_A"
   ]
  },
