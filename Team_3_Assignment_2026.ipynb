    "ranked_A = eligible_A.sort_values(\"Score\", ascending=False, kind=\"stable\").index.tolist()\n",
    "if len(chosen_A) < target_count or basket_capacity(chosen_A) < 1 - 1e-10:\n",
    "    chosen_A = []\n",
