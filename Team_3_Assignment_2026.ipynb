    "# Yahoo's end date is exclusive. A single bulk request also supplies historical FX.\n",
    "today_et = pd.Timestamp.now(tz=\"America/Toronto\")\n",
    "official = today_et >= pd.Timestamp(\"2026-11-27 16:00\", tz=\"America/Toronto\")\n",
    "price_date = buy_date if official else pd.Timestamp(end)\n",
    "print(\"Official purchase date:\" if official else \"Practice prices only:\", price_date.date())\n",
    "benchmark = \"^GSPC\"\n",
    "one_year_ago = price_date - pd.DateOffset(years=1)\n",
    "# Extra trading days provide a previous close if the anniversary was a holiday.\n",
    "download_start = min(pd.Timestamp(start), one_year_ago - pd.Timedelta(days=7))\n",
    "symbols = eligible_stocks.index.tolist() + [fx_symbol, benchmark]\n",
    "history = yf.download(symbols, start=download_start, end=price_date + pd.Timedelta(days=1),\n",
    "                      group_by=\"ticker\", auto_adjust=False, progress=False, threads=4)\n",
    "def get_field(field):\n",
    "    values = history.xs(field, level=1, axis=1).reindex(columns=symbols)\n",
    "    values.index = pd.to_datetime(values.index).tz_localize(None).normalize()\n",
    "    return values.sort_index()\n",
    "\n",
    "close = get_field(\"Close\")\n",
    "volume = get_field(\"Volume\")\n",
    "if price_date not in close.index or pd.isna(close.at[price_date, fx_symbol]):\n",
    "    raise ValueError(\"FX close unavailable for the pricing date. Retry when Yahoo publishes it.\")\n",
    "rate = float(close.at[price_date, fx_symbol])\n",
    "cad_prices = {}\n",
    "for ticker in eligible_stocks.index:\n",
    "    traded = volume.loc[start:end, ticker].where(close.loc[start:end, ticker].notna()).dropna()\n",
    "    counts = traded.groupby(traded.index.to_period(\"M\")).transform(\"count\")\n",
    "    eligible_stocks.loc[ticker, \"Avg_Volume\"] = traded[counts >= 18].mean()\n",
    "    eligible_stocks.loc[ticker, \"Close\"] = close.at[price_date, ticker]\n",
    "    prices = close.loc[start:end, ticker]\n",
    "    factor = 1.0\n",
    "    if eligible_stocks.at[ticker, \"Currency\"] == \"USD\":\n",
    "        prices = prices.ffill() * close.loc[start:end, fx_symbol].ffill()\n",
    "        factor = rate\n",
    "    cad_prices[ticker] = prices\n",
    "    eligible_stocks.loc[ticker, \"Close_CAD\"] = close.at[price_date, ticker] * factor\n",
    "\n",
    "eligible_stocks = eligible_stocks.loc[(eligible_stocks[\"Avg_Volume\"] >= 5000)\n",
    "                                      & (eligible_stocks[\"Close_CAD\"] > 0)].copy()\n",
    "# Fixed shares, price returns only. Carry the last close across market holidays.\n",
    "# Score every candidate on the same dates, starting after all have prices.\n",
    "stock_days = close.loc[start:end, eligible_stocks.index].notna().any(axis=1)\n",
    "comparison_prices = pd.DataFrame(cad_prices)[eligible_stocks.index].loc[stock_days].ffill().dropna()\n",
    "prices_cad = comparison_prices.copy()\n",
    "daily_returns = prices_cad.pct_change().dropna()\n",
    "vol = daily_returns.std()\n",
    "usable = vol[(vol > 0) & np.isfinite(vol)].index\n",
    "prices_cad = prices_cad[usable]\n",
    "daily_returns = daily_returns[usable]\n",
    "vol = vol[usable]\n",
    "if len(usable) < 10 or len(daily_returns) < 2:\n",
    "    raise ValueError(\"Too few usable stocks or common return dates. Inspect the Yahoo data.\")\n",
    "display(eligible_stocks)\n",
    "print(\"Usable stocks:\", len(usable), \"| Common daily returns:\", len(daily_returns))\n",
    "\n",
    "def calc_fee_cad(shares_num):\n",
    "    return min(0.001 * shares_num, 2.15) * rate"
   ]
