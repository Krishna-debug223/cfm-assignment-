   "source": [
    "buy_date = '2026-10-27'\n",
    "end_date = '2026-10-28'\n",
    "\n",
    "eligible_stocks['Close'] = np.nan\n",
    "\n",
    "for ticker in eligible_stocks.index.tolist():\n",
    "    history = hist_data[ticker].loc[buy_date:end_date]\n",
    "    if buy_date in history.index:\n",
    "        eligible_stocks.loc[ticker, 'Close'] = history.loc[buy_date, 'Close']\n",
    "\n",
    "mask = eligible_stocks['Close'].notna() & (eligible_stocks['Close'] > 0)\n",
    "eligible_stocks = eligible_stocks[mask].copy()\n",
    "\n",
    "eligible_stocks"
   ]
  },
