    "# Solve for the largest investment that fits each client's budget after per-stock fees.\n",
    "def build_holdings(tickers, weights, budget):\n",
    "    prices = eligible_stocks.loc[tickers, \"Close_CAD\"].to_numpy()\n",
    "    def cost(investment):\n",
    "        shares = investment * weights / prices\n",
    "        return float(np.dot(shares, prices)) + sum(calc_fee_cad(q) for q in shares)\n",
    "\n",
    "    low, high = 0.0, budget  # Try to spend all the budget.\n",
    "    for step in range(55):\n",
    "        middle = (low + high) / 2\n",
    "        if cost(middle) <= budget - 0.000001:\n",
    "            low = middle\n",
    "        else:\n",
    "            high = middle\n",
    "    shares = low * weights / prices\n",
    "    values = shares * prices\n",
    "    return pd.DataFrame({\n",
    "        \"Ticker\": tickers, \"Price\": eligible_stocks.loc[tickers, \"Close\"].to_numpy(),\n",
    "        \"Currency\": eligible_stocks.loc[tickers, \"Currency\"].to_numpy(),\n",
    "        \"Shares\": shares, \"Value\": values, \"Weight\": values / values.sum()\n",
    "    }, index=range(1, len(tickers) + 1))\n",
    "\n",
    "Portfolio_Final_A = build_holdings(portfolio_A.index.tolist(), portfolio_A[\"Weight\"].to_numpy(), budget_A)\n",
    "Portfolio_Final_B = build_holdings(selected, weights, budget_B)"
