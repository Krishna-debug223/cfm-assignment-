    "def validate_portfolio(portfolio, budget):\n",
    "    tickers = portfolio[\"Ticker\"]\n",
    "    eligible = eligible_stocks.reindex(tickers)\n",
    "    sectors = tickers.map(eligible_stocks[\"Sector\"])\n",
    "    sector_weights = portfolio.groupby(sectors)[\"Weight\"].sum()\n",
    "    fees = sum(calc_fee_cad(q) for q in portfolio[\"Shares\"])\n",
    "    spent = portfolio[\"Value\"].sum() + fees\n",
    "    return {\n",
    "        \"Tickers are eligible and unique\": tickers.is_unique and tickers.isin(eligible_stocks.index).all()\n",
    "            and eligible[\"Type\"].eq(\"EQUITY\").all() and eligible[\"Currency\"].isin([\"CAD\", \"USD\"]).all()\n",
    "            and eligible[\"Market\"].isin([\"ca_market\", \"us_market\"]).all() and sectors.notna().all()\n",
    "            and (eligible[\"Avg_Volume\"] >= 5000).all(),\n",
    "        \"10 to 20 stocks\": 10 <= len(portfolio) <= 20,\n",
    "        \"Long only, at most 15% per stock\": (portfolio[\"Weight\"] > 0).all()\n",
    "            and portfolio[\"Weight\"].max() <= 0.15 + 1e-10,\n",
    "        \"At most 40% per sector\": sector_weights.max() <= 0.40 + 1e-10,\n",
    "        \"Weights sum to 100%\": np.isclose(portfolio[\"Weight\"].sum(), 1),\n",
    "        \"Purchases plus fees fit the budget\": spent <= budget and budget - spent < 0.01\n",
    "    }\n",
    "\n",
    "checks = pd.DataFrame({\"Client A\": validate_portfolio(Portfolio_Final_A, budget_A),\n",
    "                       \"Client B\": validate_portfolio(Portfolio_Final_B, budget_B)})\n",
