    "def buy_stocks(portfolio, eligible, budget):\n",
    "    # first pass: split the budget by weight, ignoring fees\n",
    "    for ticker in portfolio.index.tolist():\n",
    "        money_for_stock = portfolio.loc[ticker, 'Weight'] * budget\n",
    "        stock_n = money_for_stock / eligible.loc[ticker, 'Close_CAD']\n",
    "        portfolio.loc[ticker, 'Shares'] = stock_n\n",
    "\n",
    "    # add up what the fees would come out to with these share counts\n",
    "    total_fees = 0\n",
    "    for ticker in portfolio.index.tolist():\n",
    "        fee = calc_fee_cad(portfolio.loc[ticker, 'Shares'])\n",
    "        total_fees = total_fees + fee\n",
    "\n",
    "    # second pass: reduce the budget by the fees, then size shares again\n",
    "    investable = budget - total_fees\n",
    "    for ticker in portfolio.index.tolist():\n",
    "        money_for_stock = portfolio.loc[ticker, 'Weight'] * investable\n",
    "        stock_n = money_for_stock / eligible.loc[ticker, 'Close_CAD']\n",
    "        portfolio.loc[ticker, 'Shares'] = stock_n\n",
    "\n",
    "    # final value + fee per stock, and a check that we spent close to budget\n",
    "    total_value = 0\n",
    "    total_fees_final = 0\n",
    "    for ticker in portfolio.index.tolist():\n",
    "        value = portfolio.loc[ticker, 'Shares'] * eligible.loc[ticker, 'Close_CAD']\n",
    "        fee = calc_fee_cad(portfolio.loc[ticker, 'Shares'])\n",
    "        portfolio.loc[ticker, 'Value'] = value\n",
    "        portfolio.loc[ticker, 'Fee'] = fee\n",
    "        total_value = total_value + value\n",
    "        total_fees_final = total_fees_final + fee\n",
    "\n",
    "    print('Total spent:', total_value + total_fees_final)\n",
    "    print('Budget:', budget)\n",
    "    print('Leftover:', budget - total_value - total_fees_final)\n",
    "\n",
    "    return portfolio\n",
    "\n",
    "portfolio_A = buy_stocks(portfolio_A, eligible_A, budget_A)\n",
    "portfolio_A"
   ]
