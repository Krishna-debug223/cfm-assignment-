   "source": [
    "TEAM = \"3\"\n",
    "budget_A = 1000000\n",
    "budget_B = 750000\n",
    "buy_date = pd.Timestamp(\"2026-11-27\")\n",
    "start = \"2025-10-01\"\n",
    "end = \"2026-09-30\"\n",
    "fx_symbol = \"USDCAD=X\"\n",
    "\n",
    "# The TA file takes priority. The example has no header and includes a duplicate.\n",
    "try:\n",
    "    ticker_file = \"Tickers.csv\"\n",
    "    ticker_column = pd.read_csv(ticker_file, header=None, dtype=str)[0]\n",
    "except FileNotFoundError:\n",
    "    ticker_file = \"Tickers_Example.csv\"\n",
    "    ticker_column = pd.read_csv(ticker_file, header=None, dtype=str)[0]\n",
    "\n",
    "tickers = ticker_column.dropna().str.strip().str.upper().drop_duplicates()\n",
    "tickers = tickers[~tickers.isin([\"\", \"TICKER\", \"TICKERS\", \"SYMBOL\"])].tolist()\n",
    "print(\"Input file:\", ticker_file, \"| Unique tickers:\", len(tickers))\n",
    "\n",
    "# Use the team's quote type, listing market, currency and sector checks.\n",
    "rows = []\n",
    "for ticker in tickers:\n",
    "    try:\n",
    "        info = yf.Ticker(ticker).get_info()\n",
    "    except Exception as error:\n",
    "        print(ticker, \"metadata unavailable:\", type(error).__name__)\n",
    "        info = {}\n",
    "    rows.append([ticker, info.get(\"longName\"), info.get(\"quoteType\"),\n",
    "                 info.get(\"market\"), info.get(\"currency\"), info.get(\"sector\"), info.get(\"beta\")])\n",
    "\n",
    "all_stocks = pd.DataFrame(rows, columns=[\"Ticker\", \"Company\", \"Type\", \"Market\",\n",
    "                                         \"Currency\", \"Sector\", \"Yahoo_Beta\"]).set_index(\"Ticker\")\n",
    "mask = (all_stocks[\"Type\"].eq(\"EQUITY\")\n",
    "        & all_stocks[\"Market\"].isin([\"us_market\", \"ca_market\"])\n",
    "        & all_stocks[\"Currency\"].isin([\"CAD\", \"USD\"])\n",
    "        & all_stocks[\"Sector\"].fillna(\"\").str.strip().ne(\"\"))\n",
    "eligible_stocks = all_stocks.loc[mask].copy()\n",
    "if eligible_stocks.empty:\n",
    "    raise ValueError(\"No usable company profiles. Check the input file and Yahoo Finance.\")\n",
    "display(all_stocks.assign(Profile_pass=mask))"
   ]
  },
