   "source": [
    "start = '2025-10-01'\n",
    "end = '2026-09-30'\n",
    "min_avg_volume = 5000\n",
    "\n",
    "for ticker in eligible_stocks.index.tolist():\n",
    "    history = hist_data[ticker].loc[start:end].copy()\n",
    "    history = history.dropna(subset=['Close', 'Volume'])\n",
    "\n",
    "    if history.empty:\n",
    "        eligible_stocks.loc[ticker, 'Avg_Volume'] = None\n",
    "        continue\n",
    "\n",
    "    history['Month'] = history.index.strftime('%Y-%m')\n",
    "    \n",
    "    month_counts = history.groupby('Month').size()\n",
    "    valid_months = month_counts[month_counts >= 18].index\n",
    "    history = history[history['Month'].isin(valid_months)]\n",
    "\n",
    "    eligible_stocks.loc[ticker, 'Avg_Volume'] = history.Volume.mean()\n",
    "\n",
    "mask = eligible_stocks['Avg_Volume'] >= min_avg_volume\n",
    "eligible_stocks = eligible_stocks[mask].copy()\n",
    "\n",
    "eligible_stocks"
   ]
  },
